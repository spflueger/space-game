# ==============================================================================
# Git Configuration Override (applied automatically inside container)
# ==============================================================================
# Overrides whatever email/name was forwarded from your host machine
GIT_USER_EMAIL=
GIT_USER_NAME=

# ==============================================================================
# LLM Provider Options (Configure at least one)
# ==============================================================================

# Option 1: OpenRouter (Claude, OpenAI, DeepSeek, etc.)
OPENROUTER_API_KEY=

# Option 2: Anthropic Direct API Key
ANTHROPIC_API_KEY=

# Option 3: General LLM Proxy / Gateway (LiteLLM, vLLM, Portkey, Ollama, etc.)
LLM_PROXY_BASE_URL=https://proxy.example.com/v1
LLM_PROXY_API_KEY=
# LLM_PROXY_API_TYPE=anthropic-messages   # Options: anthropic-messages, openai-completions, openai-responses
# LLM_PROXY_MODELS=model-a,model-b        # Optional comma-separated model list

# ==============================================================================
# GitHub Integration
# ==============================================================================
# Personal Access Token with repo/issue/PR scopes (required for `gh` CLI)
GITHUB_TOKEN=
