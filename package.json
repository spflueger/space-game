{
  "name": "space-game",
  "version": "0.1.0",
  "description": "A multiplayer, turn-based space strategy game",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc",
    "check": "tsc --noEmit",
    "check:commit-msg": "node scripts/verify-commit-msg.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
